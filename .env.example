# ClickHouse HTTP reader for Purchase Requirement details
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
PR_CLICKHOUSE_ENABLED=true
PR_CLICKHOUSE_CONNECT_TIMEOUT=1
PR_CLICKHOUSE_TIMEOUT=3
PR_CLICKHOUSE_FINAL=false
# Optional if ClickHouse tenant database names differ from MySQL:
# PR_CLICKHOUSE_DATABASES='{"dbsja":"replica_sja","dbstg":"replica_stg"}'
